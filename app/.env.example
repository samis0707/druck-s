# App base URL used for links in outbound mail (no trailing slash).
APP_BASE_URL=http://localhost:3000
# Firm inbox: receives staff approval notices; change-request replies go here.
FIRM_INBOX=print@example.com

# Better Auth. Generate a secret per environment; trusted proxies for Coolify/Traefik TLS hop.
BETTER_AUTH_SECRET=change-me-in-every-environment
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_PROXIES=

# Postgres. Local compose default; production points at managed Postgres.
DATABASE_URL=postgres://dam:dam@localhost:5432/dam

# S3-compatible object storage. Local: MinIO. Prod: Hetzner (e.g. https://fsn1.your-objectstorage.com).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dam
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO; verify against Hetzner at deploy time (see design §8).
S3_FORCE_PATH_STYLE=true

# Mail. Transport: brevo (HTTP-API, Produktion auf Railway: dort ist SMTP gesperrt) oder smtp
# (lokal: Mailpit). Leer = brevo, sobald BREVO_API_KEY gesetzt ist, sonst smtp. Siehe README.
MAIL_TRANSPORT=
# Brevo: SMTP & API › API-Keys. Absenderdomain in Brevo verifizieren; „Autorisierte IPs“ aus.
BREVO_API_KEY=
# Absender „Name <adresse>“ (fällt auf SMTP_FROM zurück); Domain muss beim Anbieter verifiziert sein.
MAIL_FROM=DAM <dam@example.com>
# Optional: Antwortadresse für alle Mails (leer = Antworten an den Absender).
MAIL_REPLY_TO=
# Optional: Anhang-Grenzen in MB übersteuern (Brevo-Standard: 20 gesamt kodiert, 4 je Datei;
# SMTP: unbegrenzt). Zu große Dateien gehen als Download-Link im Auftrag raus.
MAIL_MAX_ATTACHMENTS_MB=
MAIL_MAX_ATTACHMENT_MB=

# SMTP (optional, nur bei MAIL_TRANSPORT=smtp). Local: Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DAM <dam@example.com>

# Mistral AI. EU endpoint; model pinned (see design §8).
MISTRAL_API_BASE=https://api.eu.mistral.ai/v1
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-3.5

# ClamAV malware scanner (docs/virenscan.md). Modus: daemon (Standard; synchron per clamd beim Upload)
# oder batch (kein clamd; Dateien bekommen „Virenprüfung läuft“, der Cron-Job Dockerfile.scan prüft später).
CLAMAV_MODE=daemon
# Nur für daemon. Local: localhost:3311 (compose). Prod: clamav:3310.
CLAMAV_HOST=localhost
CLAMAV_PORT=3311

# Durations in minutes (see design Open Questions for tuning).
OTP_TTL_MINUTES=10
SESSION_TTL_HOURS=24
DRAFT_TTL_MINUTES=45
UPLOAD_LINK_TTL_DAYS=7

# Partner-Schnittstelle (docs/partner-api.md). Partner selbst: node scripts/partner-key.mjs …
# Neue Partner-Aufträge je Partner und Stunde (0 = unbegrenzt).
PARTNER_RATE_LIMIT_PER_HOUR=120
# Zeitlimit für das Laden der Partner-Datei (unter dem Client-Timeout von 60 s halten).
PARTNER_FILE_TIMEOUT_SECONDS=45
# Webhook-Zustellung aus der Outbox im App-Prozess (off = abschalten) und Takt in Sekunden.
PARTNER_WEBHOOK_WORKER=on
PARTNER_WEBHOOK_INTERVAL_SECONDS=15

# Offene Anfrage ohne Kundenkonto (docs/anfrage-api.md). Grenzen gegen Missbrauch; 0 = unbegrenzt.
INQUIRY_DRAFTS_PER_IP_PER_HOUR=30
INQUIRY_CODES_PER_DRAFT=5
INQUIRY_CODES_PER_EMAIL_PER_HOUR=5
INQUIRY_CODES_PER_IP_PER_HOUR=20
INQUIRY_CODE_ATTEMPTS=5

# Besucherstatistik (Umami, selbst betrieben, nur nach Einwilligung). Laufzeit-Variablen, kein Neubau nötig.
# Leer lassen = Statistik aus, kein Hinweis.
UMAMI_URL=
UMAMI_WEBSITE_ID=
