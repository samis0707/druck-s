# App base URL used for links in outbound mail (no trailing slash).
APP_BASE_URL=http://localhost:3000
# Firm inbox: receives staff approval notices; change-request replies go here.
FIRM_INBOX=print@example.com

# Better Auth. Generate a secret per environment; trusted proxies for Coolify/Traefik TLS hop.
BETTER_AUTH_SECRET=change-me-in-every-environment
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_PROXIES=

# Postgres. Local compose default; production points at managed Postgres.
DATABASE_URL=postgres://dam:dam@localhost:5432/dam

# S3-compatible object storage. Local: MinIO. Prod: Hetzner (e.g. https://fsn1.your-objectstorage.com).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dam
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO; verify against Hetzner at deploy time (see design §8).
S3_FORCE_PATH_STYLE=true

# Mail. Transport: brevo (HTTP-API, Produktion auf Railway: dort ist SMTP gesperrt) oder smtp
# (lokal: Mailpit). Leer = brevo, sobald BREVO_API_KEY gesetzt ist, sonst smtp. Siehe README.
MAIL_TRANSPORT=
# Brevo: SMTP & API › API-Keys. Absenderdomain in Brevo verifizieren; „Autorisierte IPs“ aus.
BREVO_API_KEY=
# Absender „Name <adresse>“ (fällt auf SMTP_FROM zurück); Domain muss beim Anbieter verifiziert sein.
MAIL_FROM=DAM <dam@example.com>
# Optional: Antwortadresse für alle Mails (leer = Antworten an den Absender).
MAIL_REPLY_TO=
# Optional: Anhang-Grenzen in MB übersteuern (Brevo-Standard: 20 gesamt kodiert, 4 je Datei;
# SMTP: unbegrenzt). Zu große Dateien gehen als Download-Link im Auftrag raus.
MAIL_MAX_ATTACHMENTS_MB=
MAIL_MAX_ATTACHMENT_MB=

# SMTP (optional, nur bei MAIL_TRANSPORT=smtp). Local: Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DAM <dam@example.com>

# Mistral AI. EU endpoint; model pinned (see design §8).
MISTRAL_API_BASE=https://api.eu.mistral.ai/v1
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-3.5

# ClamAV malware scanner (docs/virenscan.md). Modus: daemon (Standard; synchron per clamd beim Upload)
# oder batch (kein clamd; Dateien bekommen „Virenprüfung läuft“, der Cron-Job Dockerfile.scan prüft später).
CLAMAV_MODE=daemon
# Nur für daemon. Local: localhost:3311 (compose). Prod: clamav:3310.
CLAMAV_HOST=localhost
CLAMAV_PORT=3311

# Durations in minutes (see design Open Questions for tuning).
OTP_TTL_MINUTES=10
SESSION_TTL_HOURS=24
DRAFT_TTL_MINUTES=45
UPLOAD_LINK_TTL_DAYS=7

# Partner-Schnittstelle (docs/partner-api.md). Partner selbst: node scripts/partner-key.mjs …
# Neue Partner-Aufträge je Partner und Stunde (0 = unbegrenzt).
PARTNER_RATE_LIMIT_PER_HOUR=120
# Zeitlimit für das Laden der Partner-Datei (unter dem Client-Timeout von 60 s halten).
PARTNER_FILE_TIMEOUT_SECONDS=45
# Webhook-Zustellung aus der Outbox im App-Prozess (off = abschalten) und Takt in Sekunden.
PARTNER_WEBHOOK_WORKER=on
PARTNER_WEBHOOK_INTERVAL_SECONDS=15

# Offene Anfrage ohne Kundenkonto (docs/anfrage-api.md). Grenzen gegen Missbrauch; 0 = unbegrenzt.
INQUIRY_DRAFTS_PER_IP_PER_HOUR=30
INQUIRY_CODES_PER_DRAFT=5
INQUIRY_CODES_PER_EMAIL_PER_HOUR=5
INQUIRY_CODES_PER_IP_PER_HOUR=20
INQUIRY_CODE_ATTEMPTS=5

# Besucherstatistik (Umami, selbst betrieben, nur nach Einwilligung). Laufzeit-Variablen, kein Neubau nötig.
# Leer lassen = Statistik aus, kein Hinweis.
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Öffentlicher Richtpreis ohne Login (/api/v1/richtpreis, docs/kalkulation.md). 0 = unbegrenzt.
# Berechnungen je IP und Stunde; Abrufe der Artikelliste je IP und Stunde.
RICHTPREIS_PER_IP_PER_HOUR=60
RICHTPREIS_ARTIKEL_PER_IP_PER_HOUR=300

# Personalisierung (variable Daten in Druck-PDFs). Grenzen gegen Missbrauch; je-Stunde-Werte 0 = unbegrenzt.
PERS_MAX_RECORDS=2000
PERS_MAX_NUTZEN=20000
PERS_MAX_DESIGN_MB=25
PERS_MAX_FONT_MB=10
PERS_MAX_IMAGE_MB=10
PERS_MAX_TABLE_MB=10
# Gast-Entwürfe (Datensätze) werden so lange nach der letzten Änderung aufbewahrt, dann gelöscht.
PERS_DRAFT_TTL_HOURS=24
# Absolute Höchstdauer eines Entwurfs seit der Anlage (Stunden), auch wenn laufend gespeichert wird.
PERS_DRAFT_MAX_HOURS=72
# Aufbewahrung der Druckdaten einer Personalisierungs-Anfrage NACH Versand oder Rückzug, in Tagen.
# 0 = nie automatisch löschen (Standard, bis der Inhaber die Frist festlegt). Datentabelle (XLSX mit
# Personendaten) und Druck-PDF getrennt einstellbar; gelöscht wird beides samt Speicherobjekt.
PERS_DATA_RETENTION_DAYS=0
PERS_PDF_RETENTION_DAYS=0
# Entpackte XLSX-Größe (MB) und gleichzeitige PDF-Erzeugungen/Vorschauen je Instanz (0 = unbegrenzt);
# darüber antwortet die App mit 503 „Bitte gleich nochmal versuchen“.
PERS_MAX_TABLE_UNPACKED_MB=15
PERS_MAX_PARALLEL_RENDER=2
# Weitere Grenzen je Stunde (0 = unbegrenzt): je Entwurf (Prüfen/Vorschau, Absenden), Absenden je IP (Gäste),
# direktes Absenden je angemeldetem Nutzer, Speichern je Entwurf (im Speicher gezählt, je Instanz).
PERS_RENDERS_PER_DRAFT_PER_HOUR=60
PERS_SUBMITS_PER_DRAFT_PER_HOUR=10
PERS_SUBMITS_PER_IP_PER_HOUR=30
PERS_DIRECT_PER_USER_PER_HOUR=60
PERS_SAVES_PER_DRAFT_PER_HOUR=1200
# Schlüssel für die verschlüsselt gespeicherten Kundenlinks (AES-256-GCM, 32 Byte Base64: openssl rand -base64 32).
# Leer = abgeleitet aus BETTER_AUTH_SECRET. Wer den Schlüssel wechselt, kann ältere Links nicht mehr anzeigen
# (sie bleiben gültig).
PERS_LINK_KEY=

# Datenschutz: IP-Adressen, User-Agent und E-Mail-Adressen im Audit-Log nach so vielen Tagen entfernen (0 = nie).
AUDIT_ANONYMIZE_DAYS=90
PERS_PREVIEWS_PER_IP_PER_HOUR=120
PERS_CHECKS_PER_IP_PER_HOUR=120
PERS_TABLES_PER_IP_PER_HOUR=60
PERS_DRAFTS_PER_IP_PER_HOUR=30

# Client-Adresse für Mengenbegrenzungen (lib/clientIp.ts): Anzahl der vorgeschalteten Proxys, die
# X-Forwarded-For anhängen (Railway-Rand = 1; 0 = Header ignorieren, alle zählen als "unknown").
CLIENT_IP_TRUSTED_PROXIES=1
# Gemeinsames Geheimnis mit der Website digitalemedien.de (Caddy sendet es mit der Besucher-Adresse).
# Mindestens 16 Zeichen, zufällig; leer = Website-Weg aus (dann zählen alle Website-Besucher als eine Adresse).
WEBSITE_PROXY_SECRET=

# Vorschau-Modus (docs/vorschau.md): NUR für eine getrennte Vorschau-Umgebung (leere Datenbank, eigener Speicher).
# Standard aus. Mit 1: Beispieldaten beim Start, Banner, noindex, Webhook-Worker/Mistral/Umami aus, Mails nur an
# Mitarbeiter und im Ablauf eingegebene Adressen mit Betreff-Präfix „[Vorschau] “. Verweigert das Seeden, wenn
# APP_BASE_URL auf druck-s.de/www.druck-s.de zeigt.
PREVIEW_MODE=
# Mitarbeiter-Konten der Vorschau (kommagetrennt) und erlaubte Mail-Empfänger.
PREVIEW_STAFF_EMAILS=
