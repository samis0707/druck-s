# Kopieren nach .env (im Repo-Ordner app/) und ausfüllen. Die .env wird nie committet.

# Öffentliche Domain der App, DNS-A-Record zeigt auf die Instanz-IP (Caddy holt das TLS-Zertifikat selbst).
DOMAIN=druckraum.example.de
FIRM_INBOX=info@digitalemedien.de

# Zufällige Werte: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Scaleway Object Storage (Region Paris). Bucket + IAM-Schlüssel nur für diesen Bucket anlegen.
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mail: leer lassen = SMTP über Scaleway TEM (unten). Alternativ Brevo-HTTP-API: BREVO_API_KEY
# setzen (MAIL_TRANSPORT leer oder "brevo"), dann sind die SMTP-Variablen optional.
MAIL_TRANSPORT=
BREVO_API_KEY=
# Absender „Name <adresse>“; leer = SMTP_FROM. Domain muss beim Anbieter verifiziert sein.
MAIL_FROM=
MAIL_REPLY_TO=

# Scaleway Transactional Email (optional bei Brevo): Host/Port aus der TEM-Konsole übernehmen (SMTP-Zugang).
# Benutzer = Projekt-ID, Passwort = API-Secret-Key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absender muss zur verifizierten TEM-Domain gehören.
SMTP_FROM=dmp druckraum <druckraum@example.de>

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-3.5

# Plausible (Cloud): Domain eintragen, leer = aus. Wirkt erst nach einem Neubau (Build-Variable).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Nur für deploy/backup.sh (rclone-Remote "scw", siehe docs/deploy-scaleway.md)
BACKUP_BUCKET=
